@model COES.MVC.Intranet.Areas.ValidacionVTEAVTP.Models.ValidadorVTPEntradaModel

@{
    ViewBag.Title = "Analisis de Datos de Entrada para VTP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/Areas/ValidacionVTEAVTP/Content/Scripts/ValidadorVTPEntrada.js"></script>
<script src="~/Content/Scripts/jquery.easytabs.min.js"></script>
<link href="~/Content/Css/tabs.css" rel="stylesheet" />

<script src="~/Content/Scripts/contextmenu.js"></script>
<link href="~/Content/Css/contextmenu.css" rel="stylesheet" />

<script src="~/Content/Scripts/inputmaskmin.js"></script>
<link href="~/Content/Css/form.css" rel="stylesheet" />

<link href="~/Content/Css/multiselect.css" rel="stylesheet" />
<script src="~/Content/Scripts/multiselect.js"></script>

<link href="~/Areas/ValidacionVTEAVTP/Content/Css/ValidacionVTEAVTP.css" rel="stylesheet" />

<div class="form-title">
    <div class="content-titulo">Análisis de Datos de Entrada para VTP</div>
</div>

<div class="content-hijo">
    <div id="mensaje"></div>
    <div class="search-content" style="margin-bottom:10px">
        <table class="content-tabla-search" style="width:auto">
            <tr>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
            </tr>
            <tr>
                <td>Mes de Valorización:</td>
                <td>
                    <select id="cbPeriodo">                       
                        @foreach (var item in Model.PeriodoValorizacion.Periodos)
                        {
                            <option value="@item.PeriNombre">@item.PeriNombre</option>
                        }
                    </select>
                </td>
                <td>Versión:</td>
                <td>
                    <select id="cbVersion">                       
                        @foreach (var item in Model.VersionesVtp.Versiones)
                        {
                            <option value="@item.RecPotNombre">@item.RecPotNombre</option>
                        }
                    </select>
                </td>
                <td></td>

                <td>
                    <input type="button" id="btnProcesar" value='Procesar' />
                </td>
                <td>
                    <div id="mensajeProcesar" style="">NOTA: Dar clic en "Procesar" para realizar la evaluación. </div>
                </td>
            </tr>
        </table>
    </div>


    <div style="border: 1px solid #ccc; padding: 5px; margin: 2px;">
        <div style="background-color: #2980B9; padding: 5px;">
            <div class="editor-label" style="color: #FFFFFF; font-weight: bold;">
                1. Análisis de Precio de Peaje
            </div>
        </div>

        <div style="border: 1px solid #ccc; padding: 5px; margin: 2px;">
            <div style="background-color: #2980B9; padding: 5px;">
                <div class="editor-label" style="color: #FFFFFF; font-weight: bold;">
                    1.1 Registros con Error en el PPM y Peaje
                </div>
            </div>
            <div class="search-content" style="margin-bottom:10px">
                <table>
                    <tr>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                    <tr>
                        <td style="width:100px;">Empresa:</td>
                        <td style="width:300px;">
                            <select id="cbEmpresa" style="width:280px">
                              
                            </select>
                        </td>
                        <td style="width:25px">
                            <input type="button" id="btnAnterior" value='<' />
                        </td>
                        <td style="width:25px">
                            <input type="button" id="btnSiguiente" value='>' />
                        </td>
                        <td></td>
                        <td>
                            <input type="button" id="btnDescargaBarras" value='Descarga' />
                        </td>
                    </tr>
                </table>
            </div>
            <div id="tab-container" class='tab-container'>
                <ul class='etabs'>
                    <li class='tab'><a href="#barrasBrg">Barras BRG</a></li>
                    <li class='tab'><a href="#barrasNoBrg">Barras no BRG</a></li>
                </ul>
                <div class='panel-container'>
                    <div id="barrasBrg">
                        <div id="detalleBarrasBrg">
                        </div>
                    </div>
                    <div id="barrasNoBrg">
                        <div id="detalleBarrasNoBrg">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div style="border: 1px solid #ccc; padding: 5px; margin: 2px;">
            <div style="background-color: #2980B9; padding: 5px;">
                <div class="editor-label" style="color: #FFFFFF; font-weight: bold;">
                    1.2 Barras sin Analizar
                </div>
            </div>
            <div style="display: flex; justify-content: flex-end; margin: 10px 0;">
                <input type="button" id="btnDescargaBarrasSinAnalizar" value='Descarga' />
            </div>
            <div id="detalleBarrasSinAnalizar">
            </div>
        </div>
    </div>

    <div style="border: 1px solid #ccc; padding: 5px; margin: 2px;">
        <div style="background-color: #2980B9; padding: 5px;">
            <div class="editor-label" style="color: #FFFFFF; font-weight: bold;">
                2. Diferencia entre Potencia Coincidente y Declarada
            </div>
        </div>
        <div style="display: flex; justify-content: flex-end; margin: 10px 0;">
            <input type="button" id="btnDescargaDiferenciaPotencia" value='Descarga' />
        </div>
        <div id="detalleDiferenciaPotencias">
        </div>
    </div>

</div>
