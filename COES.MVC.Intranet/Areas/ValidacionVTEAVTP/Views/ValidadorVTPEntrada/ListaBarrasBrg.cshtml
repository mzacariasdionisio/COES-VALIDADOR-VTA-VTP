@model COES.MVC.Intranet.Areas.ValidacionVTEAVTP.Models.ValidadorVTPEntradaModel


<table border="0" class="pretty tabla-adicional" id="tablaListadoBarras">
    <thead>
        <tr>
            <th style="width: 100px">Código VTP</th>
            <th style="width: 70px">Empresa</th>
            <th style="width: 150px">Cliente</th>
            <th style="width: 70px">Barra</th>
            <th style="width: 70px">Tipo de usuario</th>
            <th style="width: 70px">Potencia Coincidente <br /> (kW)</th>
            <th style="width: 70px">Potencia Declarada <br /> (kW)</th>
            <th style="width: 60px;">PPM <br />(S/ / kW-mes)</th>
            <th style="width: 60px;">VTP PPM <br />(S/ / kW-mes)</th>
            <th style="width: 60px; background-color: skyblue; ">Error PPM <br />(S/ / kW-mes) </th>
            <th style="width: 60px">Peaje <br />(S/ / kW-mes)</th>
            <th style="width: 60px">VTP Peaje <br />(S/ / kW-mes)</th>
            <th style="width: 60px; background-color: skyblue;">Error Peaje <br />(S/ / kW-mes)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ListBarrasBrg)
        {
            <tr>
                <td>@item.BarrCodi</td>
                <td>@item.BarrBarraBgr </td>
                <td>@item.BarrBarraBgr</td>
                <td>@item.BarrBarraBgr</td>
                <td style="text-align: right;">@item.BarrBarraBgr</td>
                <td>@item.BarrBarraBgr</td>
                <td>@item.BarrBarraBgr</td>
                <td style="text-align: right;">
                    @item.BarrBarraBgr
                </td>

                <td style="text-align: right;">
                    @item.BarrBarraBgr
                </td>

                <td style="text-align: right;">
                    @item.BarrBarraBgr
                </td>            

                <td style="text-align: left;">@item.BarrBarraBgr</td>
                <td style="text-align: left;">@item.BarrBarraBgr</td>
                <td style="text-align: left;">@item.BarrBarraBgr</td>
            </tr>
        }

    </tbody>
</table>
