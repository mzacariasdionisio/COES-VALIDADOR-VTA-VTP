@model COES.MVC.Intranet.Areas.ValidacionVTEAVTP.Models.ValidadorVTPEntradaModel


<table border="0" class="pretty tabla-adicional" id="tablaListadoBarrasDiferencia">
    <thead>
        <tr>
            <th style="width: 80px">Código VTP</th>
            <th style="width: 90px">Empresa</th>
            <th style="width: 70px">Barra</th>
            <th style="width: 150px">Cliente</th>           
            <th style="width: 70px">Potencia Coincidente (kW)</th>
            <th style="width: 70px">Potencia Declarada (kW)</th>
            <th style="width: 60px;">Diferencia (kW)</th>
          
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.DatosVTP.TableAnas)
        {
            <tr>
                <td>@item.Codigo</td>
                <td>@item.Empresa </td>
                <td>@item.Cliente</td>
                <td>@item.Barra</td>
                <td style="text-align: center;">@(item.PotenciaCoincidente.HasValue? item.PotenciaCoincidente.Value.ToString("N4") : "")</td>
                <td style="text-align: center;">@(item.PotenciaDeclarada.HasValue ? item.PotenciaDeclarada.Value.ToString("N4") : "")</td>
                <td style="text-align: center;">
                    @(item.Diferencia.HasValue ? item.Diferencia.Value.ToString("N4") : "")
                </td>
            </tr>
        }

    </tbody>
</table>
