@model COES.MVC.Intranet.Areas.ValidacionVTEAVTP.Models.ValidadorVTPEntradaModel


<table border="0" class="pretty tabla-adicional" id="tablaListadoBarrasDiferencia">
    <thead>
        <tr>
            <th style="width: 100px">Código VTP</th>
            <th style="width: 70px">Empresa</th>
            <th style="width: 70px">Barra</th>
            <th style="width: 150px">Cliente</th>           
            <th style="width: 70px">Potencia Coincidente (kW)</th>
            <th style="width: 70px">Potencia Declarada (kW)</th>
            <th style="width: 60px;">Diferencia (kW)</th>
          
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ListBarrasBrg)
        {
            <tr>
                <td>@item.BarrCodi</td>
                <td>@item.BarrBarraBgr </td>
                <td>@item.BarrBarraBgr</td>
                <td>@item.BarrBarraBgr</td>
                <td style="text-align: right;">@item.BarrBarraBgr</td>
                <td>@item.BarrBarraBgr</td>
                <td>@item.BarrBarraBgr</td>                           
            </tr>
        }

    </tbody>
</table>
