@model COES.MVC.Intranet.Areas.ValidacionVTEAVTP.Models.ValidadorVTPEntradaModel


<table border="0" class="pretty tabla-adicional" id="tablaListadoBarrasNoBrg">
    <thead>
        <tr>
            <th style="width: 80px">Código VTP</th>
            <th style="width: 90px">Empresa</th>
            <th style="width: 150px">Cliente</th>
            <th style="width: 70px">Barra</th>
            <th style="width: 70px">Tipo de usuario</th>
            <th style="width: 70px">Potencia Coincidente <br /> (kW)</th>
            <th style="width: 70px">Potencia Declarada <br /> (kW)</th>
            <th style="width: 60px;">PPM <br />(S/ / kW-mes)</th>
            <th style="width: 60px;">VTP PPM <br />(S/ / kW-mes)</th>
            <th style="width: 60px; ">Error PPM <br />(S/ / kW-mes) </th>
            <th style="width: 60px">Peaje <br />(S/ / kW-mes)</th>
            <th style="width: 60px">VTP Peaje <br />(S/ / kW-mes)</th>
            <th style="width: 60px;">Error Peaje <br />(S/ / kW-mes)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.DatosVTP.TableVtpNoBrg)
        {
            <tr>
                <td style="text-align: center;">@item.Codigo</td>
                <td style="text-align: center;">@item.Empresa </td>
                <td style="text-align: center;">@item.Cliente</td>
                <td style="text-align: center;">@item.Barra</td>
                <td style="text-align: center;">@item.TipoUsuario</td>
                <td style="text-align: center;">@(item.PotenciaCoincidente.HasValue? item.PotenciaCoincidente.Value.ToString("N4") : "")</td>
                <td style="text-align: center;">@(item.PotenciaDeclarada.HasValue ? item.PotenciaDeclarada.Value.ToString("N4") : "")</td>
                <td style="text-align: center;">
                    @(item.Ppm.HasValue ? item.Ppm.Value.ToString("N4") : "")
                </td>

                <td style="text-align: center;">
                    @(item.VtpPpm.HasValue ? item.VtpPpm.Value.ToString("N4") : "")
                </td>

                <td style="text-align: center; background-color: skyblue;">
                    @(item.ErrorPpm.HasValue ? item.ErrorPpm.Value.ToString("N4") : "")
                </td>

                <td style="text-align: center;">@(item.Peaje.HasValue ? item.Peaje.Value.ToString("N4") : "")</td>
                <td style="text-align: center;">@(item.VtpPeaje.HasValue ? item.VtpPeaje.Value.ToString("N4") : "")</td>
                <td style="text-align: center; background-color: skyblue;">@(item.ErrorPeaje.HasValue ? item.ErrorPeaje.Value.ToString("N4") : "")</td>
            </tr>
        }

    </tbody>
</table>
