@model COES.MVC.Intranet.Areas.ValidacionVTEAVTP.Models.ValidadorVTPEntradaModel


<table border="0" class="pretty tabla-adicional" id="tablaListadoBarrasSinAnalizar">
    <thead>
        <tr>
            <th style="width: 100px">Código VTP</th>
            <th style="width: 150px">Empresa</th>
            <th style="">Cliente</th>
            <th style="width: 100px">Barra</th>
            <th style="width: 50px">Contrato</th>
            <th style="width: 70px">Tipo de usuario</th>
            <th style="width: 70px;">Precio Potencia (S/ / kW-mes)</th>
            <th style="width: 70px">Potencia Coincidente (kW)</th>
            <th style="width: 70px">Potencia Declarada (kW)</th>
            <th style="width: 70px;">Peaje Unitario (S/ / kW-mes)</th>
            <th style="width: 70px;">Factor Perdida</th>           
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ListBarrasBrg)
        {
            <tr>
                <td>@item.BarrCodi</td>
                <td>@item.BarrBarraBgr </td>
                <td>@item.BarrBarraBgr</td>
                <td>@item.BarrBarraBgr</td>
                <td style="text-align: right;">@item.BarrBarraBgr</td>
                <td>@item.BarrBarraBgr</td>
                <td>@item.BarrBarraBgr</td>
                <td style="text-align: right;">
                    @item.BarrBarraBgr
                </td>

                <td style="text-align: right;">
                    @item.BarrBarraBgr
                </td>

                <td style="text-align: right;">
                    @item.BarrBarraBgr
                </td>            

                <td style="text-align: left;">@item.BarrBarraBgr</td>               
            </tr>
        }

    </tbody>
</table>
