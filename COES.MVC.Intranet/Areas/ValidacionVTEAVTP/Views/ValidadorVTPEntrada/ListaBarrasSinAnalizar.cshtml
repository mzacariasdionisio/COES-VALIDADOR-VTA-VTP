@model COES.MVC.Intranet.Areas.ValidacionVTEAVTP.Models.ValidadorVtpEntradaModel


<table border="0" class="pretty tabla-adicional" id="tablaListadoBarrasSinAnalizar">
    <thead>
        <tr>
            <th style="width: 80px">Código VTP</th>
            <th style="width: 150px">Empresa</th>
            <th style="">Cliente</th>
            <th style="width: 100px">Barra</th>
            <th style="width: 50px">Contrato</th>
            <th style="width: 70px">Tipo de usuario</th>
            <th style="width: 70px;">Precio Potencia (S/ / kW-mes)</th>
            <th style="width: 70px">Potencia Coincidente (kW)</th>
            <th style="width: 70px">Potencia Declarada (kW)</th>
            <th style="width: 70px;">Peaje Unitario (S/ / kW-mes)</th>
            <th style="width: 70px;">Factor Pérdida</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.DatosVTP.TableVtpSinAnalizar)
        {
            <tr>
                <td>@item.Codigo</td>
                <td>@item.Empresa </td>
                <td>@item.Cliente</td>
                <td>@item.Barra</td>
                <td>@item.Contrato</td>
                <td>@item.TipoUsuario</td>
                <td style="text-align: center;">@(item.PrecioPotencia.HasValue? item.PrecioPotencia.Value.ToString("N4") : "")</td>
                <td style="text-align: center;">@(item.PotenciaCoincidente.HasValue? item.PotenciaCoincidente.Value.ToString("N4") : "")</td>
                <td style="text-align: center;">@(item.PotenciaDeclarada.HasValue ? item.PotenciaDeclarada.Value.ToString("N4") : "")</td>
                <td style="text-align: center;">@(item.PeajeUnitario.HasValue? item.PeajeUnitario.Value.ToString("N4") : "")</td>
                <td style="text-align: center;">@(item.FactorPerdida.HasValue? item.FactorPerdida.Value.ToString("N4") : "")</td>
            </tr>
        }

    </tbody>
</table>
