@{
    ViewBag.Title = "Analisis de Datos de Salida para VTP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/Areas/ValidacionVTEAVTP/Content/Scripts/ValidadorVTPSalida.js"></script>
<script src="~/Content/Scripts/jquery.easytabs.min.js"></script>
<link href="~/Content/Css/tabs.css" rel="stylesheet" />

<div class="form-title">
    <div class="content-titulo">ANÁLISIS DE DATOS DE SALIDA PARA VTP</div>
</div>

<div class="content-hijo">
    <div id="mensaje"></div>
    <div class="search-content" style="margin-bottom:10px">
        <table class="content-tabla-search" style="width:auto">
            <tr>
                <td>Mes de Valorización:</td>
                <td>
                    <select id="cbPeriodo">                       
                        @foreach (var item in Model.ListPeriodos)
                        {
                            <option value="@item.PeriNombre">@item.PeriNombre</option>
                        }
                    </select>
                </td>
                <td>Versión:</td>
                <td>
                    <select id="cbVersion">                       
                        @foreach (var item in Model.ListVersiones)
                        {
                            <option value="@item.RecPotNombre">@item.RecPotNombre</option>
                        }
                    </select>
                </td>
                <td></td>

                <td>
                    <input type="button" id="btnProcesar" value='Procesar' />
                </td>
                <td>
                    <div id="mensajeProcesar" style="">NOTA: Dar clic en "Procesar" para realizar la evaluación </div>
                </td>
            </tr>
        </table>
    </div>

    <div style="border: 1px solid #000; padding: 5px; margin: 2px;">
        <div style="padding: 5px;">
            
        </div>
       
        <div id="tab-container" class='tab-container'>
            <ul class='etabs'>
                <li class='tab'><a href="#consolidado">VALORIZACIÓN</a></li>
                <li class='tab'><a href="#reportes">COMPENSACIÓN POR PEAJE DE TRANSMISIÓN</a></li>
            </ul>
            <div class='panel-container'>
                <div id="consolidado">
                    <div style="display: flex; justify-content: flex-end;">
                        <input type="button" id="btnDescargaBarrasBrg" value='Descarga' />
                    </div>
                    <div class="consolidado-form">
                        <div id="detalleValorizacion">
                        </div>
                    </div>

                </div>
                <div id="reportes">
                    <div style="display: flex; justify-content: flex-end;">
                        <input type="button" id="btnDescargaBarrasNoBrg" value='Descarga' />
                    </div>
                    <div id="detalleCompensacion">
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
