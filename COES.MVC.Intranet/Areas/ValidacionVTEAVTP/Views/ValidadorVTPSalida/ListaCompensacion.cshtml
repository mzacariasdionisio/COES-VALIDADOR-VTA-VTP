@model COES.MVC.Intranet.Areas.ValidacionVTEAVTP.Models.ValidadorVTPSalidaModel


<table border="0" class="pretty tabla-adicional" id="tablaListadoCompensacion">
    <thead>
        <tr>
            <th style="width: 150px">Empresa</th>
            <th style="width: 70px">Comp. peaje aprox. (S/)</th>
            <th style="width: 70px;">Comp. peaje real (S/)</th>
            <th style="width: 70px;">Predicción (S/)</th>
            <th style="width: 70px;">Diferencia (S/)</th>          
            <th style="width: 70px;">Error (%)</th>
            <th style="width: 70px">Calidad</th>           
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ListBarrasBrg)
        {
            <tr>
                <td>@item.BarrCodi</td>
                <td>@item.BarrBarraBgr </td>
                <td>@item.BarrBarraBgr</td>
                <td>@item.BarrBarraBgr</td>
                <td style="text-align: right;">@item.BarrBarraBgr</td>
                <td>@item.BarrBarraBgr</td>
                <td>@item.BarrBarraBgr</td>
                      
            </tr>
        }

    </tbody>
</table>
