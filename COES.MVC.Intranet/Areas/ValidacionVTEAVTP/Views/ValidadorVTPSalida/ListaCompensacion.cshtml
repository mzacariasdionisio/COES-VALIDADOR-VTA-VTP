@model COES.MVC.Intranet.Areas.ValidacionVTEAVTP.Models.ValidadorVTPSalidaModel


<table border="0" class="pretty tabla-adicional" id="tablaListadoCompensacion">
    <thead>
        <tr>
            <th style="width: 150px">Empresa</th>
            <th style="width: 70px">Comp. peaje aprox. (S/)</th>
            <th style="width: 70px;">Comp. peaje real (S/)</th>
            <th style="width: 70px;">Predicción (S/)</th>
            <th style="width: 70px;">Diferencia (S/)</th>          
            <th style="width: 70px;">Error (%)</th>
            <th style="width: 70px">Calidad</th>           
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.VtpValidacion.Peaje.TableAnas)
        {
            if (item.Calidad.Equals("OK"))
            {
                <tr>
                    <td>@item.Empresa</td>
                    <td style="text-align: center;">@(item.CompPeajeAprox.ToString("N2") )</td>
                    <td style="text-align: center;">@(item.CompPeajeReal.ToString("N2") )</td>
                    <td style="text-align: center;">@(item.Prediccion.ToString("N2") )</td>
                    <td style="text-align: center;">@(item.Error.ToString("N2") )</td>
                    <td style="text-align: center;">@(item.ErrorPorcentaje.ToString("N2") )</td>
                    <td>@item.Calidad</td>

                </tr>
            }
            else
            {
                <tr>
                    <td style="background-color: darkred; color: white;">@item.Empresa</td>
                    <td style="background-color: darkred; color: white; text-align: center;">@(item.CompPeajeAprox.ToString("N2") )</td>
                    <td style="background-color: darkred; color: white; text-align: center;">@(item.CompPeajeReal.ToString("N2") )</td>
                    <td style="background-color: darkred; color: white; text-align: center;">@(item.Prediccion.ToString("N2") )</td>
                    <td style="background-color: darkred; color: white; text-align: center;">@(item.Error.ToString("N2") )</td>
                    <td style="background-color: darkred; color: white; text-align: center;">@(item.ErrorPorcentaje.ToString("N2") )</td>
                    <td style="background-color: darkred; color: white;">@item.Calidad</td>

                </tr>
            }

        }

    </tbody>
</table>
