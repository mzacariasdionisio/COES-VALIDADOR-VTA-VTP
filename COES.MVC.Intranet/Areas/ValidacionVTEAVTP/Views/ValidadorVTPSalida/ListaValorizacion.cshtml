@model COES.MVC.Intranet.Areas.ValidacionVTEAVTP.Models.ValidadorVtpSalidaModel


<table border="0" class="pretty tabla-adicional" id="tablaListadoValorizacion">
    <thead>
        <tr>
            <th style="width: 150px">Empresa</th>
            <th style="width: 70px">Potencia Consumida (kW)</th>
            <th style="width: 70px;">Valorización (S/)</th>
            <th style="width: 70px;">Predicción (S/)</th>
            <th style="width: 70px;">Diferencia (S/)</th>          
            <th style="width: 70px;">Error (%)</th>
            <th style="width: 70px">Calidad</th>           
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.VtpValidacion.Valorizacion.TableAnas)
        {
            if (item.Calidad.ToUpper().Equals("INCORRECTO"))
            {
                <tr>
                    <td style="background-color: darkred; color: white;">@item.Empresa</td>
                    <td style="background-color: darkred; color: white; text-align: center;">@(item.PotenciaConsumida.HasValue? item.PotenciaConsumida.Value.ToString("N2") : "")</td>
                    <td style="background-color: darkred; color: white; text-align: center;">@(item.Valorizacion.HasValue? item.Valorizacion.Value.ToString("N2") : "")</td>
                    <td style="background-color: darkred; color: white; text-align: center;">@(item.Prediccion.HasValue? item.Prediccion.Value.ToString("N2") : "")</td>
                    <td style="background-color: darkred; color: white; text-align: center;">@(item.Error.HasValue? item.Error.Value.ToString("N2") : "")</td>
                    <td style="background-color: darkred; color: white; text-align: center;">@(item.ErrorPorcentaje.HasValue? item.ErrorPorcentaje.Value.ToString("N2") : "")</td>
                    <td style="background-color: darkred; color: white;">@item.Calidad</td>

                </tr>

            }
            else
            {
                <tr>
                    <td>@item.Empresa</td>
                    <td style="text-align: center;">@(item.PotenciaConsumida.HasValue? item.PotenciaConsumida.Value.ToString("N2") : "")</td>
                    <td style="text-align: center;">@(item.Valorizacion.HasValue? item.Valorizacion.Value.ToString("N2") : "")</td>
                    <td style="text-align: center;">@(item.Prediccion.HasValue? item.Prediccion.Value.ToString("N2") : "")</td>
                    <td style="text-align: center;">@(item.Error.HasValue? item.Error.Value.ToString("N2") : "")</td>
                    <td style="text-align: center;">@(item.ErrorPorcentaje.HasValue? item.ErrorPorcentaje.Value.ToString("N2") : "")</td>
                    <td>@item.Calidad</td>

                </tr>
            }


        }

    </tbody>
</table>
