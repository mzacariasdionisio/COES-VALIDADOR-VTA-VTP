@{
    ViewBag.Title = "Analisis de Datos de VTP y VTEA";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/Areas/ValidacionVTEAVTP/Content/Scripts/ValidadorVTPVTEA.js"></script>
<script src="~/Content/Scripts/jquery.easytabs.min.js"></script>
<link href="~/Content/Css/tabs.css" rel="stylesheet" />

<div class="form-title">
    <div class="content-titulo">ANÁLISIS DE DATOS DE VTP Y VTEA</div>
</div>

<div class="content-hijo">
    <div id="mensaje"></div>
    <div class="search-content" style="margin-bottom:10px">
        <table class="content-tabla-search" style="width:auto">
            <tr>
                <td>Mes de Valorización:</td>
                <td>
                    <select id="cbPeriodo">                       
                        @foreach (var item in Model.PeriodoValorizacion.Periodos)
                        {
                            <option value="@item.PeriNombre">@item.PeriNombre</option>
                        }
                    </select>
                </td>
                <td>Versión VTP:</td>
                <td>
                    <select id="cbVersionVTP">                       
                        @foreach (var item in Model.VersionesVtp.Versiones)
                        {
                            <option value="@item.RecPotNombre">@item.RecPotNombre</option>
                        }
                    </select>
                </td>
                <td>Versión VTEA:</td>
                <td>
                    <select id="cbVersionVTEA">                       
                        @foreach (var item in Model.VersionesVtea.Versiones)
                        {
                            <option value="@item.RecaNombre">@item.RecaNombre</option>
                        }
                    </select>
                </td>
                <td></td>

                <td>
                    <input type="button" id="btnProcesar" value='Procesar' />
                </td>
                <td>
                    <div id="mensajeProcesar" style="">NOTA: Dar clic en "Procesar" para realizar la evaluación </div>
                </td>
            </tr>
        </table>
    </div>

    <div style="border: 1px solid #000; padding: 5px; margin: 2px;">
        <div style="padding: 5px;">

        </div>

        <div id="tab-container" class='tab-container'>
            <ul class='etabs'>
                <li class='tab'><a href="#consolidado">INFORMACIÓN CERO/VACÍA ENTRE VTP Y VTEA</a></li>
                <li class='tab'><a href="#reportes">DIFERENCIAS ENTRE VTP Y VTEA</a></li>
            </ul>
            <div class='panel-container'>
                <div id="consolidado">
                    <div style="border: 1px solid #000; padding: 5px; margin: 2px;">
                        <div style="background-color: #2980B9; padding: 5px;">
                            <div class="editor-label" style="color: #FFFFFF; font-weight: bold;">
                                Comparación de declaraciones VTEA cero/vacío - VTP
                            </div>
                        </div>
                        <div style="display: flex; justify-content: flex-end;">
                            <input type="button" id="btnDescargaComparacionVTEA" value='Descarga' />
                        </div>
                        <div class="consolidado-form">
                            <div id="detalleComparacionVTEA" class="content-tabla">
                            </div>
                        </div>
                    </div>
                    <div style="border: 1px solid #000; padding: 5px; margin: 2px;">
                        <div style="background-color: #2980B9; padding: 5px;">
                            <div class="editor-label" style="color: #FFFFFF; font-weight: bold;">
                                Comparación de declaraciones VTEA - VTP cero/vacío
                            </div>
                        </div>
                        <div style="display: flex; justify-content: flex-end;">
                            <input type="button" id="btnDescargaComparacionVTP" value='Descarga' />
                        </div>
                        <div class="consolidado-form">
                            <div id="detalleComparacionVTP" class="content-tabla">
                            </div>
                        </div>
                    </div>
                </div>
          
                <div id="reportes">
                    <div style="display: flex; justify-content: flex-end;">
                        <input type="button" id="btnDescargaDiferencias" value='Descarga' />
                    </div>
                    <div id="detalleComparacionDiferencias" class="content-tabla">
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>