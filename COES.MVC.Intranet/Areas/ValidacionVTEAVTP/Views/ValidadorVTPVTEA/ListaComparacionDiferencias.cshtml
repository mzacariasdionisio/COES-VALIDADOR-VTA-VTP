@model COES.MVC.Intranet.Areas.ValidacionVTEAVTP.Models.ValidadorVTPVTEAModel


<table border="0" class="pretty tabla-adicional" id="tablaListadoComparacionDiferencias">
    <thead>
        <tr>
            <th style="width: 100px">Código VTP</th>
            <th style="width: 70px">Empresa</th>
            <th style="width: 150px">Cliente</th>           
            <th style="width: 80px">Potencia VTEA (MW)</th>
            <th style="width: 80px">Potencia VTP (MW)</th>
            <th style="width: 80px">Diferencia (MW)</th>
            <th style="width: 80px;">Error resp. VTEA (%)</th>
            <th style="width: 80px;">Error resp. VTP (%)</th>           
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.VtpVteaDatos.TablesD)
        {
            <tr>
                <td>@item.CodigoVtp</td>
                <td>@item.Empresa </td>
                <td>@item.Cliente</td>
                <td style="text-align: center;">@(item.PotenciaVtea.HasValue? item.PotenciaVtea.Value.ToString("N4") : "")</td>
                <td style="text-align: center;">@(item.PotenciaVtp.HasValue? item.PotenciaVtp.Value.ToString("N4") : "")</td>
                <td style="text-align: center;">@(item.Diferencia.HasValue? item.Diferencia.Value.ToString("N4") : "")</td>
                <td style="text-align: center;">@(item.ErrorVtea.HasValue? item.ErrorVtea.Value.ToString("N2") : "")</td>
                <td style="text-align: center;">@(item.ErrorVtp.HasValue? item.ErrorVtp.Value.ToString("N2") : "")</td>
            </tr>
        }

    </tbody>
</table>
