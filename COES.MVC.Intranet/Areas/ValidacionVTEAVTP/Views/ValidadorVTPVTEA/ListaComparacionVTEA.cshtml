@model COES.MVC.Intranet.Areas.ValidacionVTEAVTP.Models.ValidadorVTPVTEAModel

<style>
    #tablaListadoComparacionVTEA .truncate-wrap {     
        word-break: break-word; 
        overflow-wrap: break-word; 
        white-space: normal; 
    }
</style>

<table border="0" class="pretty tabla-adicional" id="tablaListadoComparacionVTEA">
    <thead>
        <tr>
            <th style="width: 200px">Código VTP</th>
            <th style="width: 70px">Empresa</th>
            <th style="width: 100px">Cliente</th>           
            <th style="width: 80px">Potencia VTEA (MW)</th>
            <th style="width: 80px">Potencia VTP (MW)</th>           
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.VtpVteaDatos.TablesXY)
        {
            <tr>
                <td class="truncate-wrap">@item.CodigoVtp</td>
                <td>@item.Empresa </td>
                <td>@item.Cliente</td>
                <td style="text-align: center;">@(item.PotenciaVtp.HasValue? item.PotenciaVtp.Value.ToString("N4") : "")</td>
                <td style="text-align: center;">@(item.PotenciaVtea.HasValue? item.PotenciaVtea.Value.ToString("N4") : "")</td>
            </tr>
        }

    </tbody>
</table>
