@model COES.MVC.Intranet.Areas.ValidacionVTEAVTP.Models.ValidadorVteaAnalisisModel
@{
    ViewBag.Title = "Detalle Energia & CMg";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Areas/ValidacionVTEAVTP/Content/Css/ValidacionVTEAVTP.css" rel="stylesheet" />
@*<script src="~/Content/Scripts/highcharts.js"></script>*@
<script src="~/Areas/ValidacionVTEAVTP/Content/Scripts/ValidadorVTEAAnalisisEmpresa.js"></script>
<script src="~/Content/Scripts/highstock.js"></script>


<div class="form-title">
    <div id="divTituloDia" class="content-titulo">Energía & CMg - Día 0</div>
</div>

<div class="content-hijo">
    <div class="contenedor-header">
        <!-- Contenedor de etiquetas -->
        <div class="contenedor-tags">
            <span id="textCodigo" class="titulo-energia-empresa">
                @ViewBag.Codigo
            </span>

            <span id="textEmpresa" class="titulo-energia-empresa">
                @ViewBag.Empresa
            </span>

            <span id="textCliente" class="titulo-energia-empresa">
                @ViewBag.Cliente
            </span>
            <span id="textBarra" class="titulo-energia-empresa">
                @ViewBag.Barra
            </span>
        </div>

        <!-- Botón al final de la fila -->
        <div class="contenedor-botones">
            <input type="button" id="btnDescargaEnergiaDia" value="Descargar" />
            <input type="button" id="btnRegresar" value="Regresar" />
        </div>
        <br />
    </div>
    <div class="contenedor-dias-grid">
        @foreach (var item in Model.DetalleDiasPeriodo.VteaDcUnit)
        {
            var esObservado = item.Observado.ToUpper() == "SI";
            var colorClase = esObservado ? "bg-rojo" : "bg-gris";
            var imgSrc = Url.Content("~/Content/Images/calendar.png");
            var diaId = string.Format("btnDia{0}", item.Dia);

            <button type="button"
                    class="btn-dia-grid @colorClase"
                    onclick="verGraficoEmpresa('@item.Codigo','@item.Empresa','@item.Cliente','@item.Barra',@item.Dia,'@Model.PeriodoSeleccionado', '@Model.VersionSeleccionado')">

                <img src="@imgSrc" alt="icono" width="20" height="20" />
                @item.Dia
            </button>
        }
    </div>
    <br />
    <div id="AreaGrafico"></div>
</div>


