@{
    ViewBag.Title = "Analisis de Valorizaciones VTEA";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/Areas/ValidacionVTEAVTP/Content/Scripts/ValidadorVTEAAnalisis.js"></script>
<script src="~/Content/Scripts/jquery.easytabs.min.js"></script>
<link href="~/Content/Css/tabs.css" rel="stylesheet" />
@*<script src="~/Content/Scripts/highcharts.js"></script>*@
<script src="~/Content/Scripts/highstock.js"></script>


<div class="form-title">
    <div class="content-titulo">Análisis de Valorizaciones VTEA</div>
</div>

<div class="content-hijo">
    <div id="mensaje"></div>
    <div class="search-content" style="margin-bottom:10px">
        <table class="content-tabla-search" style="width:auto">
            <tr>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
            </tr>
            <tr>
                <td>Mes de Valorización:</td>
                <td>
                    <select id="cbPeriodo">
                        @foreach (var item in Model.PeriodoValorizacion.Periodos)
                        {
                            <option value="@item.PeriCodi">@item.PeriNombre</option>
                        }
                    </select>
                </td>
                <td>Versión VTEA:</td>
                <td>
                    <select id="cbVersion">
                        @foreach (var item in Model.VersionesVtea.Versiones)
                        {
                            <option value="@item.RecaCodi">@item.RecaNombre</option>
                        }
                    </select>
                </td>
                <td></td>

                <td>
                    <input type="button" id="btnProcesar" value='Procesar' />
                </td>

                <td colspan="2">
                    <div id="mensajeProcesar" style="">NOTA: Dar clic en "Procesar" para realizar la evaluación </div>
                </td>
                <td>&nbsp;</td>
                <td style="width:100px;">&nbsp;</td>
                <td style="text-align:end;">
                   
                </td>
            </tr>
        </table>
    </div>

    <div style="border: 1px solid #ffffff; padding: 5px; margin: 2px;">
        <div style="padding: 5px;">

        </div>

        <div id="tab-container" class='tab-container'>
            <ul class='etabs'>
                <li class='tab'><a href="#RolEmpresa">Rol de Empresa</a></li>
                <li class='tab'><a href="#Energia">Energia & CMg</a></li>
            </ul>
            <div class='panel-container'>
                <div id="RolEmpresa">
                    <div style="display: flex; justify-content: flex-end; margin: 10px 0;">
                        <input type="button" id="btnDescargaRolEmpresa" value='Descarga' />
                    </div>
                    <div id="detalleRolEmpresa">
                    </div>
                </div>
                <div id="Energia">
                    <div style="display: flex; justify-content: flex-end; margin: 10px 0;">
                        <input type="button" id="btnDescargaEnergia" value='Descarga' />
                    </div>
                    <div id="detalleEnergia">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="popupGrafico" class="general-popup" style="width:900px">
    <span class="button b-close"><span>X</span></span>
    <div class="popup-title"><span id="span_pop_title">Historico x Empresa</span></div>
    <div style="margin-top: 20px; display: flex; align-items: center;">

        <span style=" background-color: #FFF9CC; color: #B38B00; padding: 6px 12px; border-radius: 5px; margin-right: 10px; font-weight: bold; ">
            <span style="color: #FF5733;"></span> 0 - No Participo
        </span>

        <span style=" background-color: #FFE6E0; color: #CC2E00; padding: 6px 12px; border-radius: 5px; margin-right: 10px; font-weight: bold; ">
            <span style="color: #3375FF;"></span> 1 - Comprador
        </span>

        <span style="
        background-color: #E0F8EC;
        color: #1C7C4D;
        padding: 6px 12px;
        border-radius: 5px;
        margin-right: 10px;
        font-weight: bold;
    ">
            <span style="color: #33C46A;"></span> 2 - Vendedor
        </span>
    </div>
    <br />
    <div id="AreaGrafico"></div>
</div>