@model COES.MVC.Intranet.Areas.ValidacionVTEAVTP.Models.ValidadorVteaAnalisisModel


<table border="0" class="pretty tabla-adicional" id="tablaListadoEnergia">
    <thead>
        <tr>
            <th style="width: 80px">Código</th>
            <th style="width: 150px">Empresa</th>
            <th style="width: 120px">Cliente</th>
            <th style="width: 80px">Barra</th>
            <th style="width: 70px">Tipo</th>
            <th style="width: 70px">Observado</th>
            <th style="width: 70px">Gráfico</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.DatosValidadorVTEA.InfoDeclaracionResumen)
        {
            <tr>
                <td style="text-align: center;">@item.Codigo</td>
                <td style="text-align: left;">@item.Empresa </td>
                <td style="text-align: left;">@item.Cliente</td>
                <td style="text-align: left;">@item.Barra</td>
                <td style="text-align: center;">@item.Tipo</td>
                <td style="text-align: center;">@item.Observado</td>
                <td style="text-align: center; vertical-align: middle;">
                    <div style="text-align: center;">
                        <a href="JavaScript:verGraficoEmpresaEnergia('@item.Codigo', '@item.Empresa', '@item.Cliente', '@item.Barra');" title="Gráfico">
                            <img src="~/Content/Images/prn-ico-glineas.png" alt="" style="display: inline-block;">
                        </a>
                    </div>
                </td>

            </tr>
        }

    </tbody>
</table>
