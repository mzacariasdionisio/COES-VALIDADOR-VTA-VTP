@model COES.MVC.Intranet.Areas.ValidacionVTEAVTP.Models.ValidadorVteaAnalisisModel
<style>
    .titulo-cambio {
        background-color: #FFF9CC; /* Amarillo claro */
        color: #B38B00; /* Amarillo oscuro / dorado */
        padding: 6px 12px;
        border-radius: 5px;
        margin-right: 10px;
        font-weight: bold;
    }

    .titulo-grupo-rojo {
        background-color: #FDECEA; /* Rojo muy claro */
        color: #C62828; /* Rojo oscuro */
        padding: 6px 12px;
        border-radius: 5px;
        margin-right: 10px;
        font-weight: bold;
    }

    .titulo-grupo-verde {
        background-color: #E6F4EA; /* Verde muy claro */
        color: #2E7D32; /* Verde oscuro */
        padding: 6px 12px;
        border-radius: 5px;
        margin-right: 10px;
        font-weight: bold;
    }

    .titulo-sin-color {
        background-color: transparent;
        color: inherit; /* Usa el color del texto normal */
        padding: 6px 12px;
        border-radius: 5px;
        margin-right: 10px;
        font-weight: bold;
        border: 1px solid #999; /* Borde gris neutro */
    }
</style>

<table border="0" class="pretty tabla-icono display compact" id="tablaListadoEnergia">
    <thead>
        <tr>
            <th style="width: 50px">Código</th>
            <th style="width: 180px">Empresa</th>
            <th style="width: 180px">Cliente</th>
            <th style="width: 180px">Barra</th>
            <th style="width: 40px">Tipo</th>
            <th style="width: 40px">Observado</th>
            <th style="width: 40px">Gráfico</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.DatosValidadorVTEA.InfoDeclaracionResumen)
        {
            <tr>
                <td style="text-align: center;">@item.Codigo</td>
                <td style="text-align: left;">@item.Empresa </td>
                <td style="text-align: left;">@item.Cliente</td>
                <td style="text-align: left;">@item.Barra</td>
                @if (item.Tipo.ToUpper().Equals("RETIRO"))
                {
                    <td style="text-align: center; padding: 8px;"><span class="titulo-grupo-rojo">@item.Tipo</span></td>
                }
                else if (item.Tipo.ToUpper().Equals("ENTREGA"))
                {
                    <td style="text-align: center; padding: 8px;"><span class="titulo-grupo-verde">@item.Tipo</span></td>
                }
                else
                {
                    <td style="text-align: center; padding: 8px;"><span class="titulo-sin-color">@item.Tipo</span></td>
                }
               
                @if (item.Observado.ToUpper().Equals("SI"))
                {
                    <td style="text-align: center; padding: 8px;"><span class="titulo-cambio">@item.Observado</span></td>
                }
                else
                {
                    <td style="text-align: center; padding: 8px;"><span class="titulo-sin-color">@item.Observado</span></td>
                }

                <td style="text-align: center;">
                    <div style="text-align: center;">
                        <a href="JavaScript:verGraficoEmpresaEnergia('@item.Codigo', '@item.Empresa', '@item.Cliente', '@item.Barra');" title="Gráfico">
                            <img src="~/Content/Images/prn-ico-glineas.png" alt="" style="display: inline-block;">
                        </a>
                    </div>
                </td>

            </tr>
        }

    </tbody>
</table>
