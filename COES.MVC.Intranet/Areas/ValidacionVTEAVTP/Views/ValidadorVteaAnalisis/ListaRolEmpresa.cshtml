@model COES.MVC.Intranet.Areas.ValidacionVTEAVTP.Models.ValidadorVteaAnalisisModel

<style>
    .titulo-cambio {
        background-color: #FFF9CC; /* Amarillo claro */
        color: #B38B00; /* Amarillo oscuro / dorado */
        padding: 6px 12px;
        border-radius: 5px;
        margin-right: 10px;
        font-weight: bold;        
    }
    .titulo-grupo-rojo {
        background-color: #FDECEA; /* Rojo muy claro */
        color: #C62828; /* Rojo oscuro */
        padding: 6px 12px;
        border-radius: 5px;
        margin-right: 10px;
        font-weight: bold;
    }
    .titulo-grupo-verde {
        background-color: #E6F4EA; /* Verde muy claro */
        color: #2E7D32; /* Verde oscuro */
        padding: 6px 12px;
        border-radius: 5px;
        margin-right: 10px;
        font-weight: bold;
    }
    .titulo-sin-color {
        background-color: transparent;
        color: inherit; /* Usa el color del texto normal */
        padding: 6px 12px;
        border-radius: 5px;
        margin-right: 10px;
        font-weight: bold;
        border: 1px solid #999; /* Borde gris neutro */
    }
</style>


 <table border="0" class="pretty tabla-icono display compact" id="tablaListadoRolEmpresa">
    <thead>
        <tr>
            <th style="width: 400px">Empresa</th>
            <th style="width: 40px">Cambio</th>
            <th style="width: 40px">Grupo Actual</th>
            <th style="width: 40px">Grupo Previo</th>
            <th style="width: 40px">Tasa</th>
            <th style="width: 40px">Gráfico</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.DatosValidadorVTEA.InfoEmpresaResumen)
        {
            <tr>
                <td style="text-align: left;">@item.Company</td>
                @if (item.Change.ToUpper().Equals("SI"))
                {
                    <td style="text-align: center; padding: 8px;"><span class="titulo-cambio">@item.Change</span></td>
                }
                else
                {
                    <td style="text-align: center; padding: 8px;"><span class="titulo-sin-color">@item.Change</span></td>
                }

                @if (item.TeamNow.ToUpper().Equals("COMPRADOR"))
                {
                    <td style="text-align: center; padding: 8px;"><span class="titulo-grupo-rojo">@item.TeamNow</span></td>
                }
                else if (item.TeamNow.ToUpper().Equals("VENDEDOR"))
                {
                    <td style="text-align: center; padding: 8px;"><span class="titulo-grupo-verde">@item.TeamNow</span></td>
                }
                else
                {
                    <td style="text-align: center; padding: 8px;"><span class="titulo-sin-color">@item.TeamNow</span></td>
                }

                @if (item.TeamPrev.ToUpper().Equals("VENDEDOR"))
                {
                    <td style="text-align: center; padding: 8px;"><span class="titulo-grupo-verde">@item.TeamPrev</span></td>
                }
                else if (item.TeamPrev.ToUpper().Equals("COMPRADOR"))
                {
                    <td style="text-align: center; padding: 8px;"><span class="titulo-grupo-rojo">@item.TeamPrev</span></td>
                }
                else
                {
                    <td style="text-align: center; padding: 8px;"><span class="titulo-sin-color">@item.TeamPrev</span></td>
                }

                <td style="text-align: center;">@item.Rate</td>
                <td>
                    <div style="text-align: center;">
                        <a href="JavaScript:verGraficoEmpresa('@item.Company');" title="Gráfico">
                            <img src="~/Areas/ValidacionVTEAVTP/Content/Images/grafico.png" alt="">
                        </a>
                    </div>
                </td>

            </tr>
        }

    </tbody>
</table>
