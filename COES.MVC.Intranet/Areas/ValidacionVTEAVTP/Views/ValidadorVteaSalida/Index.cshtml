@{
    ViewBag.Title = "Analisis de Datos de Retiro para VTEA";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/Areas/ValidacionVTEAVTP/Content/Scripts/ValidadorVTeaSalida.js"></script>
<script src="~/Content/Scripts/jquery.easytabs.min.js"></script>
<link href="~/Content/Css/tabs.css" rel="stylesheet" />

<div class="form-title">
    <div class="content-titulo">Análisis de Datos de Retiro para VTEA</div>
</div>

<div class="content-hijo">
    <div id="mensaje"></div>
    <div class="search-content" style="margin-bottom:10px">
        <table class="content-tabla-search" style="width:auto">
            <tr>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
            </tr>
            <tr>
                <td>Mes de Valorización:</td>
                <td>
                    <select id="cbPeriodo">
                        @foreach (var item in Model.PeriodoValorizacion.Periodos)
                        {
                            <option value="@item.PeriNombre">@item.PeriNombre</option>
                        }
                    </select>
                </td>
                <td>Versión:</td>
                <td>
                    <select id="cbVersion">
                        @foreach (var item in Model.VersionesVtea.Versiones)
                        {
                            <option value="@item.RecaNombre">@item.RecaNombre</option>
                        }
                    </select>
                </td>
                <td></td>

                <td>
                    <input type="button" id="btnProcesar" value='Procesar' />
                </td>

                <td colspan="2">
                    <div id="mensajeProcesar" style="">NOTA: Dar clic en "Procesar" para realizar la evaluación </div>
                </td>
                <td>&nbsp;</td>
                <td style="width:100px;">&nbsp;</td>
                <td style="text-align:end;">
                    <input type="button" id="btnDescarga" value='Descarga' />
                </td>
            </tr>
        </table>
    </div>

    <div style="border: 1px solid #ffffff; padding: 5px; margin: 2px;">
        <div style="padding: 5px;">

        </div>

        <div id="tab-container" class='tab-container'>
            <ul class='etabs'>
                <li class='tab'><a href="#RetirosNegativos">Retiros Negativos</a></li>
                <li class='tab'><a href="#SinDeclaracion">Sin Declaración</a></li>
                <li class='tab'><a href="#DeclaracionesNuevas">Declaraciones Nuevas</a></li>
                <li class='tab'><a href="#FinContrato">Fin de Contrato</a></li>
            </ul>
            <div class='panel-container'>
                <div id="RetirosNegativos">                 
                    <div id="detalleRetirosNegativos">
                    </div>
                </div>
                <div id="SinDeclaracion">                  
                    <div id="detalleSinDeclaracion">
                    </div>
                </div>
                <div id="DeclaracionesNuevas">                  
                    <div id="detalleDeclaracionesNuevas">
                    </div>
                </div>
                <div id="FinContrato">                  
                    <div id="detalleFinContrato">
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>