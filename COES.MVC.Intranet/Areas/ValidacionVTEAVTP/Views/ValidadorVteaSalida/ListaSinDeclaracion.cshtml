@model COES.MVC.Intranet.Areas.ValidacionVTEAVTP.Models.ValidadorVteaSalidaModel


<table border="0" class="pretty tabla-adicional" id="tablaListadoSinDeclaracion">
    <thead>
        <tr>
            <th style="width: 80px">Código</th>
            <th style="width: 90px">Empresa</th>
            <th style="width: 150px">Cliente</th>
            <th style="width: 70px">Barra</th>
            <th style="width: 70px">Inicio De Contrato</th>
            <th style="width: 70px">Fin de Contrato</th>
            <th style="width: 70px">Descripción</th>           
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.DatosVTEA.TableHE)
        {
            <tr>
                <td style="text-align: center;">@item.Codigo</td>
                <td style="text-align: center;">@item.Empresa </td>
                <td style="text-align: center;">@item.Cliente</td>
                <td style="text-align: center;">@item.Barra</td>
                <td style="text-align: center;">@item.InicioContrato</td>
                <td style="text-align: center;">@item.FinContrato</td>
                <td style="text-align: center;">@item.Descripcion</td>
               
            </tr>
        }

    </tbody>
</table>
