@model COES.MVC.Intranet.Areas.Yupana.Models.CondicionInicialModel
@{
    ViewBag.Title = "Configuración";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/Content/Scripts/jqueryui.js"></script>
<script src="~/Content/Scripts/jquery.easytabs.min.js"></script>
<link href="~/Content/Css/form.css" rel="stylesheet" />
<link href="~/Content/Css/tabs.css" rel="stylesheet" />
<script src="~/Content/Scripts/datatable.js"></script>
<script src="~/Content/Scripts/plupload.full.min.js"></script>
<script src="~/Areas/Yupana/Content/Scripts/configCondicionInicial.js?v=1.0.6"></script>
<link href="~/Areas/Yupana/Content/Css/css.css" rel="stylesheet" />
<link href="~/Areas/Yupana/Content/Css/estilosYupana.css?v=1.0.1" rel="stylesheet" />


<div class="form-title">
    <div class="content-titulo">Configuración de recursos</div>
    <div class="content-botonera">
        <input type="button" id="btnRegresar" value="Regresar" />
    </div>
</div>

<div class="content-hijo">
    <div id="mensaje"></div>

    <div id="tab-container" class='tab-container'>
        <ul class='etabs'>
            <li class='tab' id="tab_caldero"><a href="#caldero">Calderos</a></li>
            <li class='tab' id="tab_inyeccion"><a href="#inyeccion">Inyecciones</a></li>
        </ul>
        <div class='panel-container'>
            <div id="caldero">
                <div class="search-content" style="margin-bottom:10px">
                    <table class="content-tabla-search" style="width:auto">
                        <tr>
                            <td>
                                <input type="button" id="btnNuevoCaldero" value="Nuevo" />

                            </td>
                        </tr>
                    </table>
                </div>

                <div id="listadoCaldero">

                </div>

            </div>

            <div id="inyeccion">

                <div class="search-content" style="margin-bottom:10px">
                    <table class="content-tabla-search" style="width:auto">
                        <tr>
                            <td>
                                <input type="button" id="btnNuevoInyeccion" value="Nuevo" />

                            </td>
                        </tr>
                    </table>
                </div>
                <div id="listadoInyeccion">

                </div>


            </div>
        </div>
        <br />
        <br />
    </div>
</div>

<div id="popupFormulario" class="general-popup" style="width: 480px; height:270px;">

</div>

<div id="popupRelaciones" class="general-popup" style="width:1800px">
    <div><span class="button b-close"><span>X</span></span></div>
    <div class="popup-title"><span>Relación con Modos de Operación</span></div>
    <div class="popup-text" id="contenidoRelaciones" style="margin-top:0">

    </div>
</div>
