@model COES.MVC.Intranet.Areas.Yupana.Models.CondicionInicialModel
@{
    ViewBag.Title = "Configuración Maestra";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/Content/Scripts/jqueryui.js"></script>
<script src="~/Content/Scripts/jquery.easytabs.min.js"></script>
<link href="~/Content/Css/form.css" rel="stylesheet" />
<link href="~/Content/Css/tabs.css" rel="stylesheet" />
<script src="~/Areas/Yupana/Content/Scripts/configuracion.js?v=1.0.1"></script>
<link href="~/Areas/Yupana/Content/Css/css.css" rel="stylesheet" />


<div class="form-title">
    <div class="content-titulo">Configuración Data Maestra</div>
</div>

<div class="content-hijo">
    <div id="mensaje"></div>

    <div id="tab-container" class='tab-container'>
        <ul class='etabs'>
            <li class='tab' id="tab_modo"><a href="#modOp">Modo de Operación</a></li>
            <li class='tab' id="tab_hidro"><a href="#hidro">Unidades Hidro</a></li>
            <li class='tab' id="tab_rer"><a href="#rer">Unidades RER</a></li>
        </ul>
        <div class='panel-container'>
            <div id="modOp">
                <div class="search-content" style="margin-bottom:10px">
                    <table class="content-tabla-search" style="width:auto">
                        <tr>
                            <td>
                                <input type="button" id="btnNuevoModo" value="Nuevo" />

                            </td>
                        </tr>
                    </table>
                </div>

                <div id="listadoModo">

                </div>

            </div>

            <div id="hidro">
                <div class="search-content" style="margin-bottom:10px">
                    <table class="content-tabla-search" style="width:auto">
                        <tr>
                            <td>
                                <input type="button" id="btnNuevoHidro" value="Nuevo" />

                            </td>
                        </tr>
                    </table>
                </div>

                <div id="listadoHidro">

                </div>

            </div>

            <div id="rer">

                <div class="search-content" style="margin-bottom:10px">
                    <table class="content-tabla-search" style="width:auto">
                        <tr>
                            <td>
                                <input type="button" id="btnNuevoRer" value="Nuevo" />

                            </td>
                        </tr>
                    </table>
                </div>
                <div id="listadoRer">

                </div>


            </div>
        </div>
        <br />
        <br />
    </div>
</div>

<div id="popupFormulario" class="general-popup" style="width: 480px; height:270px;">

</div>