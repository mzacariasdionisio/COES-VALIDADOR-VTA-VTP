@model  COES.MVC.Intranet.Areas.Yupana.Models.GeneracionMetaModel
<script>
    $(function () {
        $('#cbSemana').val($('#hfSemana').val());

        $('#cbSemana').change(function () {
            obtenerRangoFechasPorSemana();
        });
    }
    );
</script>
<select id="cbSemana" name="IdSemana" name="IdHorizonte" style="width:110px;">

    @foreach (var item in Model.ListaSemana)
    {
        <option value="@item.IdTipoInfo">@item.NombreTipoInfo</option>
    }
</select>
