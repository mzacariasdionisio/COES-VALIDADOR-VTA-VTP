@model COES.MVC.Intranet.Areas.Yupana.Models.GeneracionMetaModel
@{
    ViewBag.Title = "Configuración de Registros de Generación Meta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/Content/Scripts/jqueryui.js"></script>
<script src="~/Areas/Yupana/Content/Scripts/configGM.js?v=1.0.6"></script>
<link href="~/Areas/Yupana/Content/Css/css.css" rel="stylesheet" />
<link href="~/Areas/Yupana/Content/Css/estilosYupana.css?v=1.0.6" rel="stylesheet" /> <!-- para ancho tabla relaciones junto con css -->


<div class="form-title">
    <div class="content-titulo">Configuración de Registros de Generación Meta</div>
    <div class="content-botonera">
        <input type="button" id="btnNuevo" value="Nuevo" />
        <input type="button" id="btnRegresar" value="Regresar" />
    </div>
</div>

<div class="content-hijo" id="mainLayout">
    <div id="mensaje"></div>

    <div class="table-list" id="listado">
    </div>

    <div style="clear:both; height:30px"></div>
</div>

<div id="popupFormulario" class="general-popup" style="width: 490px; height:220px;">

</div>

<div id="popupRelaciones" class="general-popup" style="width: 2000px; height:720px;">
    <div><span class="button b-close"><span>X</span></span></div>
    <div class="popup-title"><span>Relación con Equipos</span></div>
    <div class="popup-text" id="contenidoRelaciones" style="margin-top:0">

    </div>
</div>
