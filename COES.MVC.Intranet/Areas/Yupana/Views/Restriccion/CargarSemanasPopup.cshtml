@model  COES.MVC.Intranet.Areas.Yupana.Models.RestriccionModel
<script>
    $(function () {
        $('#cbSemanaCopia').val($('#hfSemanaCopia').val());
        $('#cbSemanaCopia').change(function () {
            obtenerRangoFechasPorSemanaCopia();
        });
    }
    );
</script>
<select id="cbSemanaCopia" name="IdSemanaCopia" style="width:110px;">
    @foreach (var item in Model.ListaSemana)
    {
        <option value="@item.IdTipoInfo">@item.NombreTipoInfo</option>
    }
</select>