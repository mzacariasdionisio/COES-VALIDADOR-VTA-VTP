@model COES.MVC.Intranet.Areas.Yupana.Models.RestriccionModel
@{
    ViewBag.Title = "Configuración";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/Content/Scripts/jqueryui.js"></script>
<script src="~/Areas/Yupana/Content/Scripts/configRestriccion.js?v=1.0.8"></script>
<link href="~/Areas/Yupana/Content/Css/css.css" rel="stylesheet" />
<link href="~/Areas/Yupana/Content/Css/estilosYupana.css?v=1.0.1" rel="stylesheet" />


<div class="form-title">
    <div class="content-titulo">Configuración de Restricciones de generación</div>
    <div class="content-botonera">
        <input type="button" id="btnNuevo" value="Nuevo" />
        <input type="button" id="btnRegresar" value="Regresar" />
    </div>
</div>

<div class="content-hijo" id="mainLayout">
    <div id="mensaje"></div>

    <div class="table-list" id="listado">
    </div>

    <div style="clear:both; height:30px"></div>
</div>

<div id="popupFormulario" class="general-popup" style="width: 480px; height:270px;">

</div>

<div id="popupRelaciones" class="general-popup" style="width: 1800px; height:800px;">
    <div><span class="button b-close"><span>X</span></span></div>
    <div class="popup-title"><span>Relación con equipos</span></div>
    <div class="popup-text" id="contenidoRelaciones" style="margin-top:0">

    </div>
</div>
