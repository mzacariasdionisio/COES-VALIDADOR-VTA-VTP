@model  COES.MVC.Intranet.Areas.Yupana.Models.RestriccionModel
@{
    ViewBag.Title = "Restricciones de generación";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/Areas/Hidrologia/Content/Scripts/handsontable.full.min.js"></script> @*version 2021*@
<link href="~/Areas/Hidrologia/Content/Css/handsontable.full.min.css" rel="stylesheet" /> @*version 2021*@
<script src="~/Content/Scripts/plupload.full.min.js"></script>
<script src="~/Content/Scripts/datatable.js"></script>
<script src="~/Content/Scripts/inputmaskmin.js"></script>
<script src="~/Content/Scripts/moment.js"></script>
<script src="~/Content/Scripts/datetime-moment.js"></script>

<script src="~/Areas/Yupana/Content/Scripts/restriccion.js?v=1.1.4"></script>
<link href="~/Areas/Yupana/Content/Css/css.css?v=1.1.1" rel="stylesheet" />
<link href="~/Areas/Yupana/Content/Css/estilosYupana.css?v=1.0.0" rel="stylesheet" />


<div class="form-title">
    <div class="content-titulo"> Restricciones de generación</div>
    <div class="content-botonera">
        <input type="button" id="btnConfigurar" value='Configuración' />
    </div>
</div>
<div class="content-hijo">
    <div class='action-message' id='mensaje' style="margin-bottom:5px; margin-top:0; ">Por favor seleccione horizonte y fecha.</div>

    <div class="search-content" style="padding-top: 5px; padding-bottom: 1px;">
        <table>
            <tr>
                <td style="vertical-align: middle;">
                    <table class="content-tabla-search" style="width:auto">
                        <tr>
                            <td>Horizonte:</td>
                            <td>
                                <select id="cbHorizonte" name="IdHorizonte" style="width:110px;">
                                    <option value="1">Diario</option>
                                    <option value="2">Reprograma</option>
                                    <option value="3">Semanal</option>
                                </select>
                                <input type="hidden" id="hfHorizonte" />
                            </td>
                            <td></td>
                            <td>
                                <div id="dDia">
                                    Fecha:
                                    <input type="text" name="Fecha" id="txtFecha" value="@Model.Dia" />
                                </div>
                                <div id="dSemana" style="display:none">
                                    Año:
                                    <input type="text" id="Anho" name="Año" style="width:70px;" value="@Model.Anho" onchange=CargarSemanaAnho2() />
                                    <input type="hidden" id="hfAnho" value="@Model.Anho" />
                                    Semana:
                                    <div id="SemanaIni" style="display:inline-block"> </div>
                                    <input type="hidden" id="hfSemana" value="@Model.NroSemana" />
                                </div>
                                <input type="hidden" id="hfFecha" />
                                <input type="hidden" id="hfFecIniSem" value="@Model.FechaIniSem" />
                                <input type="hidden" id="hfFecFinSem" value="@Model.FechaFinSem" />

                                @*<input type="hidden" id="hfIdEnvio" value="@Model.IdEnvio" />*@

                            </td>
                            <td>
                                <input type="button" id="btnConsultar" value="Consultar" />
                            </td>
                        </tr>
                    </table>

                </td>

                <td style="text-align: center; float: right;">
                    <table class="content-tabla-search" style="width:auto">
                        <tr>
                            <td class="content-action">
                                <a href="#" id="btnDescargar">
                                    <div class="content-item-action">
                                        <img src="~/Content/Images/bajar.png" /><br />
                                        <span>Descargar plantilla</span>
                                    </div>
                                </a>
                            </td>
                            <td class="content-action">
                                <a href="#" id="btnImportar">
                                    <div class="content-item-action">
                                        <img src="~/Content/Images/subir.png" /><br />
                                        <span>Cargar</span>
                                    </div>
                                </a>
                            </td>
                            <td class="content-action">
                                <a href="#" id="btnCopiar">
                                    <div class="content-item-action">
                                        <img src="~/Content/Images/copiar.png" /><br />
                                        <span>Copiar</span>
                                    </div>
                                </a>
                            </td>
                            <td class="content-action">
                                <a href="#" id="btnMostrarErrores">
                                    <div class="content-item-action">
                                        <img src="~/Areas/DemandaCP/Content/Images/errores.png" /><br />
                                        <span>Mostrar errores</span>
                                    </div>
                                </a>
                            </td>

                            <td class="content-action">
                                <a href="#" id="btnEnviarDatos">
                                    <div class="content-item-action">
                                        <img src="~/Areas/DemandaCP/Content/Images/enviar.png" /><br />
                                        <span>Enviar datos</span>
                                    </div>
                                </a>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </div>

    <div>
        <div id="contenedorRestricciones">
            <div id="tblRestricciones" class="hot" style=" margin: 0 auto; "> </div>
        </div>
    </div>

</div>

<div id="contenedorErrores" class="popup-class-1 general-popup">
    <span class="button b-close"><span>X</span></span>
    <div class="popup-title"><span>Detalle de Errores</span></div>
    <div class="panel-container">
        <div id="tablaErrores" style="height:350px;">

        </div>

    </div>
</div>

<div id="erroresImportacion" class="general-popup" style="z-index:9999999999;height: 350px; width:820px">
    <div><span class="button b-close"><span>X</span></span></div>
    <div class="popup-title"><span>Detalle de Errores Generales de Importación</span></div>
    <div class="popup-text" style="margin-top:5px">
        <div id="vistaVersion">
            <div id='mensajeErrorI' style="margin-bottom:5px; margin-top:0; "></div>
            <div class="content-tabla">
                <div style="clear:both; height:5px"></div>

                <div class="content-tabla">
                    <table id="tblErroresImportacion" class="pretty tabla-adicional " style="width:100%">
                        <thead>
                            <tr>
                                <th>Fila</th>
                                <th>Dato</th>
                                <th>Error</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="popupCopiar" class="general-popup" style="width: auto; height:auto;">

</div>

<input type="hidden" id="hfMes" value="@Model.Mes" />
<input type="hidden" id="hfDataExcel" value="" />
<input type="hidden" id="hfIndicador" />




